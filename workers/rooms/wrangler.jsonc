{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cobra-duel-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3100,http://127.0.0.1:3100,http://127.0.0.1:3101" },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
