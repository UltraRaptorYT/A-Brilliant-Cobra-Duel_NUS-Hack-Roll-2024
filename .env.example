# Optional: local ONNX export. Default is models/laya (relative to project root).
LAYA_MODEL_DIR=models/laya
# Windows GPU acceleration (optional): dml. Use cpu on other servers.
LAYA_DEVICE=cpu
LAYA_DEVICE_ID=0
# fp32 preserves the exported model. int8 is opt-in and can change choices.
LAYA_PRECISION=fp32

# Optional GPT provider. Never use NEXT_PUBLIC_ for this secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudflare rooms Worker. Local development: npm run rooms:dev
# Production: wss://cobra-duel-rooms.<your-subdomain>.workers.dev
NEXT_PUBLIC_ROOMS_URL=ws://127.0.0.1:8787
