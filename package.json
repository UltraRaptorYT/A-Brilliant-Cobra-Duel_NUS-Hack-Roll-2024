{
  "name": "a-brilliant-cobra-duel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib scripts tests playwright.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:laya": "tsx scripts/test-laya.ts",
    "test:e2e": "playwright test",
    "rooms:dev": "wrangler dev --config workers/rooms/wrangler.jsonc --port 8787",
    "rooms:types": "wrangler types workers/rooms/worker-configuration.d.ts --config workers/rooms/wrangler.jsonc",
    "rooms:typecheck": "tsc --project workers/rooms/tsconfig.json",
    "rooms:deploy": "wrangler deploy --config workers/rooms/wrangler.jsonc",
    "test:rooms": "vitest run --config workers/rooms/vitest.config.mts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.30.0",
    "openai": "^4.24.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^4.12.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
